# Copy to .env for local use. Never commit .env. On Vercel, set these as
# environment variables in the project settings instead.

# --- required ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=       # random string you invent: openssl rand -hex 24
GROQ_API_KEY=
REDIS_URL=                     # or KV_REDIS_URL (Vercel/Upstash creates this one)

# --- strongly recommended ---
ALLOWED_TELEGRAM_IDS=          # comma-separated numeric Telegram user ids; only these may use the bot

# --- optional ---
GEMINI_API_KEY=
GEMINI_MODEL=                  # empty = auto-pick at runtime
GROQ_MODEL=openai/gpt-oss-120b
NSE_MIN_INTERVAL_SECONDS=1.0
REDIS_MAX_MEMORY_MB=30          # your Redis plan's memory cap (Upstash free via Vercel: 30)
MARKET=IN
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
